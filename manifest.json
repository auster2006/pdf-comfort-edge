{
  "manifest_version": 3,
  "name": "PDF 护眼阅读器",
  "version": "1.0.0",
  "description": "在 Edge 中用黑底白字、暖色纸张和阅读尺阅读 PDF。",
  "icons": {
    "16": "icons/pdf-16.png",
    "32": "icons/pdf-32.png",
    "48": "icons/pdf-48.png",
    "128": "icons/pdf-128.png"
  },
  "action": {
    "default_title": "打开 PDF 护眼阅读器",
    "default_icon": {
      "16": "icons/pdf-16.png",
      "32": "icons/pdf-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["file:///*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
